{
  "cli": {
    "version": ">= 16.19.3",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "android": { "buildType": "apk" },
      "cache": { "disabled": false }
    },
    "production": {
      "android": { "buildType": "app-bundle" },
      "cache": { "disabled": false }
    }
  },
  "submit": {
    "production": {}
  }
}
