{
  "expo": {
    "name": "groceries-app",
    "slug": "groceries-app",
    "scheme": "groceries",
    "splash": {
      "image": "./assets/icono.png",
      "resizeMode": "contain",
      "backgroundColor": "#FD1648"
    },
    "extra": {
      "EXPO_PUBLIC_API_URL": "https://api-compare-products-app.onrender.com",
      "router": {},
      "eas": {
        "projectId": "5d77ce7e-2783-4640-b0ad-916d31957da5"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-camera",           
      "expo-barcode-scanner"
    ],
    "router": {
      "root": "src/app/pages"
    },
    "userInterfaceStyle": "light",
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icono.png",
        "backgroundColor": "#FD1648"
      },
      "edgeToEdge": true,
      "permissions": [
        "android.permission.CAMERA"  
      ],
      "package": "com.francorep2.groceriesapp",
      "versionCode": 1              
    },
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "favicon": "./assets/icono.png"
    }
  }
}
